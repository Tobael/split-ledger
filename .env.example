# Production values are stored together in the GitHub Actions ENV_FILE secret.
SPLITLEDGER_DOMAIN=expenses.example.com
SPLITLEDGER_RELAY_DOMAIN=relay.expenses.example.com
# Required by the project deployment workflow; use at least 32 random characters.
RELAY_ADMIN_TOKEN=

# Relay abuse and resource limits. These defaults may be adjusted by operators.
MAX_OPERATION_SIZE_BYTES=65536
MAX_OPERATIONS_PER_GROUP=1000000
MAX_GROUP_STORAGE_BYTES=67108864
MAX_TOTAL_STORAGE_BYTES=1073741824
MAX_NAMESPACES=10000
MAX_WS_MESSAGE_SIZE_BYTES=131072
MAX_NAMESPACE_CREATIONS_PER_IP_PER_MINUTE=30
MAX_PUBLISHES_PER_IP_PER_MINUTE=3000
MAX_UPLOAD_BYTES_PER_IP_PER_MINUTE=16777216
MAX_RATE_LIMIT_SOURCES=10000
MAX_CONNECTIONS_PER_IP=50
TRUST_PROXY=true
WS_IDLE_TIMEOUT_MS=300000
PAGE_SIZE=500
# 0 retains ciphertext indefinitely. A positive value prunes older operations.
OPERATION_RETENTION_DAYS=0
