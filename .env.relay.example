RELAY_PORT=8443
# Optional. Enables authenticated storage inspection and namespace blocking.
# Generate at least 32 random characters, for example with: openssl rand -base64 48
RELAY_ADMIN_TOKEN=
MAX_OPERATION_SIZE_BYTES=65536
MAX_OPERATIONS_PER_GROUP=1000000
MAX_GROUP_STORAGE_BYTES=67108864
MAX_TOTAL_STORAGE_BYTES=1073741824
MAX_NAMESPACES=10000
MAX_WS_MESSAGE_SIZE_BYTES=131072
MAX_NAMESPACE_CREATIONS_PER_IP_PER_MINUTE=30
MAX_PUBLISHES_PER_IP_PER_MINUTE=3000
MAX_UPLOAD_BYTES_PER_IP_PER_MINUTE=16777216
MAX_RATE_LIMIT_SOURCES=10000
# Leading zero bits required when establishing a previously unknown namespace.
ADMISSION_DIFFICULTY_BITS=16
MAX_CONNECTIONS_PER_IP=50
# Enable only when the relay port is reachable exclusively through a trusted reverse proxy.
TRUST_PROXY=true
WS_IDLE_TIMEOUT_MS=300000
PAGE_SIZE=500
# 0 disables automatic deletion. Positive values permanently delete older ciphertext.
OPERATION_RETENTION_DAYS=0
