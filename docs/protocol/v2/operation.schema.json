{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fair-money.example/schemas/protocol/v2/operation.schema.json",
  "title": "Fair Money protocol v2 signed operation",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "operationId", "groupId", "parents", "lamportClock", "createdAt", "actorPublicKey", "payload", "signature"],
  "properties": {
    "protocolVersion": { "const": 2 },
    "operationId": { "$ref": "#/$defs/hash" },
    "groupId": { "$ref": "#/$defs/id" },
    "parents": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hash" }
    },
    "lamportClock": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "createdAt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "actorPublicKey": { "$ref": "#/$defs/publicKey" },
    "payload": { "$ref": "#/$defs/payload" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "publicKey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
    "id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f-]+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "expenseData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "amountMinorUnits", "currency", "paidBy", "splits"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "amountMinorUnits": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "paidBy": { "$ref": "#/$defs/id" },
        "splits": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "category": { "type": "string", "maxLength": 100 }
      }
    },
    "payload": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "groupName", "creatorParticipantId", "creatorDisplayName"],
          "properties": {
            "type": { "const": "GroupCreated" }, "groupName": { "$ref": "#/$defs/name" },
            "creatorParticipantId": { "$ref": "#/$defs/id" }, "creatorDisplayName": { "$ref": "#/$defs/name" },
            "expenseEditPolicy": { "enum": ["collaborative", "creator-only", "expense-author"] }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "participantId", "displayName"],
          "properties": { "type": { "enum": ["ParticipantSlotCreated", "ParticipantSlotRenamed"] }, "participantId": { "$ref": "#/$defs/id" }, "displayName": { "$ref": "#/$defs/name" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "participantId"],
          "properties": { "type": { "enum": ["ParticipantSlotDisabled", "ParticipantSlotReset"] }, "participantId": { "$ref": "#/$defs/id" }, "reason": { "type": "string", "maxLength": 500 } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "capabilityId", "scope", "secretCommitment"],
          "properties": { "type": { "const": "ClaimCapabilityIssued" }, "capabilityId": { "$ref": "#/$defs/id" }, "scope": { "enum": ["targeted", "any-unclaimed-slot"] }, "participantId": { "$ref": "#/$defs/id" }, "secretCommitment": { "$ref": "#/$defs/hash" }, "displayExpiresAt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } },
          "allOf": [
            { "if": { "properties": { "scope": { "const": "targeted" } } }, "then": { "required": ["participantId"] } },
            { "if": { "properties": { "scope": { "const": "any-unclaimed-slot" } } }, "then": { "not": { "required": ["participantId"] } } }
          ]
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "capabilityId"],
          "properties": { "type": { "const": "ClaimCapabilityRevoked" }, "capabilityId": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "capabilityId", "participantId", "claimantRootPublicKey", "claimSecret"],
          "properties": { "type": { "const": "ParticipantSlotClaimed" }, "capabilityId": { "$ref": "#/$defs/id" }, "participantId": { "$ref": "#/$defs/id" }, "claimantRootPublicKey": { "$ref": "#/$defs/publicKey" }, "claimSecret": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "expenseId", "expense"],
          "properties": { "type": { "const": "ExpenseCreated" }, "expenseId": { "$ref": "#/$defs/id" }, "expense": { "$ref": "#/$defs/expenseData" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "expenseId", "expense", "reason"],
          "properties": { "type": { "const": "ExpenseCorrected" }, "expenseId": { "$ref": "#/$defs/id" }, "expense": { "$ref": "#/$defs/expenseData" }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "expenseId"],
          "properties": { "type": { "const": "ExpenseVoided" }, "expenseId": { "$ref": "#/$defs/id" }, "reason": { "type": "string", "maxLength": 500 } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "settlementId", "from", "to", "amountMinorUnits", "currency"],
          "properties": { "type": { "const": "SettlementCreated" }, "settlementId": { "$ref": "#/$defs/id" }, "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" }, "amountMinorUnits": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "ownerRootPublicKey", "devicePublicKey", "deviceName"],
          "properties": { "type": { "const": "DeviceAuthorized" }, "ownerRootPublicKey": { "$ref": "#/$defs/publicKey" }, "devicePublicKey": { "$ref": "#/$defs/publicKey" }, "deviceName": { "$ref": "#/$defs/name" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "ownerRootPublicKey", "devicePublicKey"],
          "properties": { "type": { "const": "DeviceRevoked" }, "ownerRootPublicKey": { "$ref": "#/$defs/publicKey" }, "devicePublicKey": { "$ref": "#/$defs/publicKey" }, "reason": { "type": "string", "maxLength": 500 } }
        }
      ]
    }
  }
}
